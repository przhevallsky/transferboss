{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{application=\"transfer-service\"}[5m])",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "title": "Error Rate %",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_requests_seconds_count{application=\"transfer-service\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"transfer-service\"}[5m]))",
          "legendFormat": "error %"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } }
      }
    },
    {
      "title": "Latency p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=\"transfer-service\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"transfer-service\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"transfer-service\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "Transfers Created by Corridor",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(transfers_created_total{application=\"transfer-service\"}[5m])",
          "legendFormat": "{{corridor}} / {{delivery_method}}"
        }
      ],
      "options": { "stacking": { "mode": "normal" } },
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "title": "Transfers Completed vs Failed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(transfers_completed_total{application=\"transfer-service\"}[5m])",
          "legendFormat": "completed ({{corridor}})"
        },
        {
          "expr": "rate(transfers_failed_total{application=\"transfer-service\"}[5m])",
          "legendFormat": "failed ({{corridor}} {{reason}})"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "title": "Transfer Completion Time p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(transfer_completion_time_seconds_bucket{application=\"transfer-service\"}[5m])) by (le, corridor))",
          "legendFormat": "p95 {{corridor}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "Circuit Breaker State",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state{application=\"transfer-service\"}",
          "legendFormat": "{{name}} — {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "CLOSED", "color": "green" }, "1": { "text": "OPEN", "color": "red" }, "2": { "text": "HALF_OPEN", "color": "yellow" } } }] }
      }
    },
    {
      "title": "Circuit Breaker Calls",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "targets": [
        {
          "expr": "rate(resilience4j_circuitbreaker_calls_seconds_count{application=\"transfer-service\"}[5m])",
          "legendFormat": "{{name}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["transfer-service", "red"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Transfer Service — RED + Business",
  "uid": "transfer-service-red"
}
